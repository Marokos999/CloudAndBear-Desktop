<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Tokeni teme: jedino mesto gde se menjaju boje, razmaci i veličine slova.
    Vrednosti su PRIVREMENE (postolje), pravi izgled određuje Marko.
    Pogledi koriste samo ove ključeve ({DynamicResource ...}), nikad ruke upisane vrednosti.
  -->

  <!-- Boje -->
  <Color x:Key="BackgroundColor">#101820</Color>
  <Color x:Key="SurfaceColor">#0D141C</Color>
  <Color x:Key="SurfaceRaisedColor">#17222F</Color>
  <Color x:Key="BorderColor">#243447</Color>
  <Color x:Key="AccentColor">#9ECBFF</Color>
  <Color x:Key="TextColor">#E6EAEE</Color>
  <Color x:Key="TextMutedColor">#8A99A8</Color>
  <Color x:Key="SuccessColor">#4ADE80</Color>
  <Color x:Key="WarningColor">#FBBF24</Color>
  <Color x:Key="DangerColor">#F87171</Color>

  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

  <!-- Tekst na glavnom dugmetu (Fluent klasa "accent"): tamno na svetlom akcentu -->
  <SolidColorBrush x:Key="AccentButtonForeground" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{StaticResource BackgroundColor}" />

  <!-- Pozadina desktopa: tamni sloj preko slike (boja pozadine, oko 25 % neprozirnosti) -->
  <Color x:Key="WallpaperDimColor">#40101820</Color>
  <SolidColorBrush x:Key="WallpaperDimBrush" Color="{StaticResource WallpaperDimColor}" />

  <!-- Terminal: pozadina, tekst, kursor, izabrani tekst i 16 osnovnih boja (ANSI 0-15) -->
  <Color x:Key="TerminalBackgroundColor">#0B1118</Color>
  <Color x:Key="TerminalForegroundColor">#D7DEE6</Color>
  <Color x:Key="TerminalCursorColor">#9ECBFF</Color>
  <Color x:Key="TerminalSelectionColor">#559ECBFF</Color>
  <Color x:Key="TerminalAnsi0Color">#1B2128</Color>
  <Color x:Key="TerminalAnsi1Color">#E06C75</Color>
  <Color x:Key="TerminalAnsi2Color">#98C379</Color>
  <Color x:Key="TerminalAnsi3Color">#E5C07B</Color>
  <Color x:Key="TerminalAnsi4Color">#61AFEF</Color>
  <Color x:Key="TerminalAnsi5Color">#C678DD</Color>
  <Color x:Key="TerminalAnsi6Color">#56B6C2</Color>
  <Color x:Key="TerminalAnsi7Color">#ABB2BF</Color>
  <Color x:Key="TerminalAnsi8Color">#5C6370</Color>
  <Color x:Key="TerminalAnsi9Color">#FF7B86</Color>
  <Color x:Key="TerminalAnsi10Color">#B5E890</Color>
  <Color x:Key="TerminalAnsi11Color">#F0D08A</Color>
  <Color x:Key="TerminalAnsi12Color">#7DC1FF</Color>
  <Color x:Key="TerminalAnsi13Color">#D895EE</Color>
  <Color x:Key="TerminalAnsi14Color">#6FD0DC</Color>
  <Color x:Key="TerminalAnsi15Color">#E6EAEE</Color>
  <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="{StaticResource TerminalBackgroundColor}" />

  <!-- Razmaci -->
  <x:Double x:Key="SpaceXS">4</x:Double>
  <x:Double x:Key="SpaceS">8</x:Double>
  <x:Double x:Key="SpaceM">16</x:Double>
  <x:Double x:Key="SpaceL">24</x:Double>
  <x:Double x:Key="SpaceXL">32</x:Double>

  <!-- Zaobljenje uglova -->
  <CornerRadius x:Key="RadiusS">4</CornerRadius>
  <CornerRadius x:Key="RadiusM">8</CornerRadius>
  <CornerRadius x:Key="RadiusL">16</CornerRadius>

  <!-- Monospace font (isti redosled kao u terminalu; na Debianu DejaVu Sans Mono iz paketa fonts-dejavu-core) -->
  <FontFamily x:Key="FontMono">Cascadia Mono, DejaVu Sans Mono, Consolas, Liberation Mono, monospace</FontFamily>

  <!-- Veličine slova -->
  <x:Double x:Key="FontSizeCaption">13</x:Double>
  <x:Double x:Key="FontSizeBody">16</x:Double>
  <x:Double x:Key="FontSizeTitle">22</x:Double>
  <x:Double x:Key="FontSizeHeadline">32</x:Double>
  <x:Double x:Key="FontSizeDisplay">48</x:Double>

</ResourceDictionary>
